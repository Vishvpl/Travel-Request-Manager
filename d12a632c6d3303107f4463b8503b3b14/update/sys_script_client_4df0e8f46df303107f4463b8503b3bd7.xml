        <name>Return Date valid</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
   if (isLoading || newValue === '') {
      return;
   }

   var depart = g_form.getValue('departure_date');

if (!depart)
return;

var depDate = new Date(depart);
var retDate = new Date(newValue);

if (retDate < depDate) {
g_form.showFieldMsg(
'date',
'Return Date cannot be before Departure Date',
'error'
);
}
   
}]]></script>
